# ─────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini

# ─────────────────────────────────────────────────────────────
# JVM crash dumps
# ─────────────────────────────────────────────────────────────
hs_err_pid*.log
replay_pid*.log
*.hprof

# ─────────────────────────────────────────────────────────────
# Logs / scratch
# ─────────────────────────────────────────────────────────────
*.log
logs/
tmp/
scratch/

# ─────────────────────────────────────────────────────────────
# Generated hotspot reports (output of the CLI itself)
# ─────────────────────────────────────────────────────────────
hotspot-report/
*.csv.bak

# Ad-hoc demo runs (configs reference absolute user paths and
# the outputs are environment-specific; do not commit).
demo/

# ─────────────────────────────────────────────────────────────
# Secrets / user-level configuration
# Never commit a real config — only the bundled sample under
# src/main/resources/templates is allowed.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
hotspot.yml
hotspot.yaml
hotspot-*.yml
hotspot-*.yaml
hotspot.local.yml
hotspot.local.yaml
*.pem
*.key
credentials.json
.secrets/

# ─────────────────────────────────────────────────────────────
